{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitEasy",
  "version": "1.0.0",
  "identifier": "com.giteasy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitEasy",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "GitEasy",
    "copyright": "GitEasy",
    "category": "DeveloperTool",
    "shortDescription": "A Git client that uses the real words",
    "longDescription": "GitEasy is a Git client for people who have not learned Git yet — and a fast one for people who have. It uses the same vocabulary as every tutorial and explains each term wherever it appears.",
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "GitEasy",
        "installerHooks": "installer/hooks.nsh"
      },
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}
